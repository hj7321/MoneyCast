# All secrets belong to the Node backend only. Never use VITE_ or EXPO_PUBLIC_ for keys.
PORT=8787
HOST=127.0.0.1
# marketaux is the default. Get a free account token at https://www.marketaux.com
NEWS_PROVIDER=marketaux
MARKETAUX_API_TOKEN=
# Optional legacy/custom gateway: set NEWS_PROVIDER=gateway and both variables below.
NEWS_PROVIDER_URL=
NEWS_API_KEY=
# For a physical mobile device only: start API with HOST=0.0.0.0 on a trusted LAN.
# Set EXPO_PUBLIC_API_URL in apps/mobile/.env to your PC LAN address, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8787
