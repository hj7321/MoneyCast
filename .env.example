# All secrets belong to the Node backend only. Never use VITE_ or EXPO_PUBLIC_ for keys.
PORT=8787
HOST=127.0.0.1
# marketaux is the default. Get a free account token at https://www.marketaux.com
NEWS_PROVIDER=marketaux
MARKETAUX_API_TOKEN=
# Sources used together. GDELT needs no key and is only queried by the daily scheduled collection. Leave empty for both, or name one to turn the other off.
NEWS_SOURCES=marketaux,gdelt
# Optional legacy/custom gateway: set NEWS_PROVIDER=gateway and both variables below.
NEWS_PROVIDER_URL=
NEWS_API_KEY=
# Daily collection: Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/collect.
# Use a long random value (16+ characters). Without it the route answers 503.
CRON_SECRET=
# Snapshots in a private Vercel Blob store. On Vercel, connecting the store to the project
# provides BLOB_STORE_ID and OIDC automatically. Locally, a read-write token enables them.
BLOB_READ_WRITE_TOKEN=
# Two-model check of articles without a provider score, plus Korean summaries.
# Gemini free tier: create the key in Google AI Studio and never link a billing account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Cloudflare Workers AI on the Free plan: account ID and an API token with Workers AI Read and Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Leave empty for both models. Naming only one keeps every AI label provisional.
LLM_PROVIDERS=
# For a physical mobile device only: start API with HOST=0.0.0.0 on a trusted LAN.
# Set EXPO_PUBLIC_API_URL in apps/mobile/.env to your PC LAN address, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8787
