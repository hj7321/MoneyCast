{
  "name": "moneycast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @moneycast/web",
    "dev:api": "tsx watch --include .env server/index.ts",
    "mobile": "npm run start --workspace @moneycast/mobile",
    "mobile:android": "npm run android --workspace @moneycast/mobile",
    "mobile:ios": "npm run ios --workspace @moneycast/mobile",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test packages/core/src/*.test.ts server/*.test.ts apps/web/src/*.test.tsx",
    "news:check": "tsx scripts/check-news.ts",
    "ai:check": "tsx scripts/check-ai.ts",
    "goal:check": "tsx scripts/check-goal.ts",
    "build": "npm run build --workspace @moneycast/web",
    "start": "tsx server/index.ts",
    "mobile:export": "npm run export --workspace @moneycast/mobile"
  },
  "dependencies": { "@vercel/blob": "^2.8.2", "dotenv": "^16.6.1", "react": "19.1.0", "react-dom": "19.1.0" },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
